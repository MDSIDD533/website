  <script>
    (function () {
      const DURATION = __DURATION__;
      const defaults = {
        headline_line_1: "ONE CORE",
        headline_line_2: "MANY PARTS",
        accent_line: 2,
        headline_line_1_size: 92,
        headline_line_2_size: 92,
        statement_line: "A single form can carry a whole system.",
        feature_line_1: "A clear center",
        feature_line_2: "Moving parts in orbit",
        feature_line_3: "Labels that stay readable",
      };
      let runtimeVariables = {};
      try {
        runtimeVariables = window.__hyperframes?.getVariables?.() || {};
      } catch (error) {
        runtimeVariables = {};
      }
      const vars = { ...defaults, ...runtimeVariables };

      const headlineIds = ["shape-headline-1", "shape-headline-2"];
      const headlineKeys = ["headline_line_1", "headline_line_2"];
      const accentLine = Math.max(1, Math.min(2, Number(vars.accent_line) || defaults.accent_line));
      headlineIds.forEach((id, index) => {
        const element = document.getElementById(id);
        if (!element) return;
        const text = String(vars[headlineKeys[index]] ?? "");
        const requested = Number(vars[`${headlineKeys[index]}_size`]) || 92;
        const fitted = Math.floor(790 / (0.68 * Math.max(1, Array.from(text).length)));
        element.style.display = text.trim() ? "block" : "none";
        element.style.fontSize = `${Math.max(56, Math.min(requested, fitted))}px`;
        element.classList.toggle("is-accent", index + 1 === accentLine);
      });

      const statement = document.getElementById("shape-statement-anim");
      if (statement && String(vars.statement_line || "").length > 62) {
        statement.style.fontSize = "40px";
      }

      ["shape-feature-1", "shape-feature-2", "shape-feature-3"].forEach((id, index) => {
        const element = document.getElementById(id);
        if (!element) return;
        const text = String(vars[`feature_line_${index + 1}`] || "");
        element.style.display = text.trim() ? "flex" : "none";
      });

      const at = (fraction) => Math.max(0, fraction * DURATION);
      const span = (fraction) => Math.max(0.18, fraction * DURATION);
      const exitAt = Math.max(at(0.78), DURATION - 0.44);
      const exitSpan = Math.min(0.36, Math.max(0.18, DURATION - exitAt - 0.04));

      const tl = gsap.timeline({ paused: true });
      tl.fromTo(
        "#shape-copy-anim",
        { opacity: 0, x: -90 },
        { opacity: 1, x: 0, duration: span(0.08), ease: "power4.out" },
        at(0.025),
      );
      tl.fromTo(
        "#shape-statement-anim",
        { opacity: 0, y: 44 },
        { opacity: 1, y: 0, duration: span(0.075), ease: "power3.out" },
        at(0.2),
      );
      tl.fromTo(
        "#shape-feature-1",
        { opacity: 0, x: -38 },
        { opacity: 1, x: 0, duration: span(0.062), ease: "power3.out" },
        at(0.42),
      );
      tl.fromTo(
        "#shape-feature-2",
        { opacity: 0, x: -38 },
        { opacity: 1, x: 0, duration: span(0.062), ease: "power3.out" },
        at(0.505),
      );
      tl.fromTo(
        "#shape-feature-3",
        { opacity: 0, x: -38 },
        { opacity: 1, x: 0, duration: span(0.062), ease: "power3.out" },
        at(0.59),
      );
      tl.to(
        [
          "#shape-copy-anim",
          "#shape-statement-anim",
          "#shape-feature-1",
          "#shape-feature-2",
          "#shape-feature-3",
        ],
        { opacity: 0, y: -18, filter: "blur(6px)", duration: exitSpan, ease: "power3.in" },
        exitAt,
      );
      window.__timelines["shape-text"] = tl;
    })();
