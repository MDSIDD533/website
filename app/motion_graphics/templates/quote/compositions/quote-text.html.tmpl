      let runtimeVariables = {};
      try {
        runtimeVariables = window.__hyperframes?.getVariables?.() || {};
      } catch (error) {
        runtimeVariables = {};
      }
      const vars = { ...defaults, ...runtimeVariables };

      const lineIds = ["quote-line-1", "quote-line-2", "quote-line-3"];
      const accentLine = Math.max(1, Math.min(3, Number(vars.accent_line) || defaults.accent_line));
      lineIds.forEach((id, index) => {
        const element = document.getElementById(id);
        if (!element) return;
        const key = `quote_line_${index + 1}`;
        const text = String(vars[key] ?? "");
        const requested = Number(vars[`${key}_size`]) || defaults[`${key}_size`];
        const fitted = Math.floor(1480 / (0.62 * Math.max(1, Array.from(text).length)));
        element.style.display = text.trim() ? "block" : "none";
        element.style.fontSize = `${Math.max(56, Math.min(requested, fitted))}px`;
        element.classList.toggle("is-accent", index + 1 === accentLine);
      });

      const hasRole = Boolean(String(vars.speaker_role || "").trim());
      const divider = document.getElementById("quote-speaker-divider");
      const role = document.getElementById("quote-speaker-role");
      if (divider) divider.style.display = hasRole ? "inline" : "none";
      if (role) role.style.display = hasRole ? "inline" : "none";

      const responseText = String(vars.response_line || "");
      const hasResponse =
        (vars.has_response === true || vars.has_response === "true") && Boolean(responseText.trim());
      const response = document.getElementById("quote-response");
      if (response && !hasResponse) response.style.display = "none";
      const responseLine = document.getElementById("quote-response-line");
      if (responseLine && Array.from(responseText).length > 46) {
        responseLine.style.fontSize = "38px";
      }

      const context = document.getElementById("quote-context");
      if (context && !String(vars.context_line || "").trim()) {
        context.style.display = "none";
      }

      const at = (fraction) => Math.max(0, fraction * DURATION);
      const span = (fraction) => Math.max(0.18, fraction * DURATION);
      const exitAt = Math.max(at(0.78), DURATION - 0.44);
      const exitSpan = Math.min(0.36, Math.max(0.18, DURATION - exitAt - 0.04));

      const tl = gsap.timeline({ paused: true });
      tl.fromTo(
        "#quote-kicker-anim",
        { opacity: 0, y: -18 },
        { opacity: 1, y: 0, duration: span(0.06), ease: "power3.out" },
        at(0.025),
      );
      tl.fromTo(
        "#quote-mark",
        { opacity: 0, scale: 0.72, filter: "blur(14px)" },
        {
          opacity: 0.92,
          scale: 1,
          filter: "blur(0px)",
          duration: span(0.09),
          ease: "power3.out",
          transformOrigin: "50% 50%",
