<template>
  <style>
    #root {
      position: absolute;
      inset: 0;
      overflow: hidden;
      background: #0a0a0f;
    }
    #quote-stage-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
  </style>
  <div
    id="root"
    data-composition-id="quote-stage"
    data-width="1920"
    data-height="1080"
    data-composition-variables='[{"id":"has_response","type":"boolean","label":"Has response","default":true},{"id":"ground_color","type":"color","label":"Ground color","default":"#0a0a0f"},{"id":"accent_color","type":"color","label":"Accent color","default":"#d4af37"},{"id":"secondary_color","type":"color","label":"Secondary color","default":"#4a90d9"},{"id":"muted_color","type":"color","label":"Muted color","default":"#8b98a8"}]'
  >
    <canvas id="quote-stage-canvas" class="clip" data-start="0" data-duration="__DURATION__" data-track-index="0"></canvas>
  </div>
  <script src="assets/lib/three.min.js"></script>
  <script>
    (function () {
      const DURATION = __DURATION__;
      const defaults = {
        has_response: true,
        ground_color: "#0a0a0f",
        accent_color: "#d4af37",
        secondary_color: "#4a90d9",
        muted_color: "#8b98a8",
      };
      let runtimeVariables = {};
      try {
        runtimeVariables = window.__hyperframes?.getVariables?.() || {};
      } catch (error) {
        runtimeVariables = {};
      }
      const vars = { ...defaults, ...runtimeVariables };
      const hasResponse = vars.has_response === true || vars.has_response === "true";

      const clamp01 = (v) => Math.max(0, Math.min(1, v));
      const seg = (t, a, b) => clamp01((t - a) / (b - a));
      const easeOut = (v) => 1 - Math.pow(1 - clamp01(v), 3);
      const lerp = (a, b, v) => a + (b - a) * v;
      const hash = (i) => {
        const x = Math.sin(i * 127.1 + 311.7) * 43758.5453;
        return x - Math.floor(x);
      };

      const ground = new THREE.Color(vars.ground_color);
      const accent = new THREE.Color(vars.accent_color);
      const secondary = new THREE.Color(vars.secondary_color);
      const muted = new THREE.Color(vars.muted_color);

      const canvas = document.getElementById("quote-stage-canvas");
      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: false,
        powerPreference: "high-performance",
      });
      renderer.setPixelRatio(1);
      renderer.setSize(1920, 1080, false);
      renderer.setClearColor(ground, 1);
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.08;

      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(ground, 0.026);
      const camera = new THREE.PerspectiveCamera(42, 1920 / 1080, 0.1, 100);

      scene.add(new THREE.AmbientLight(0x33415e, 1.7));
      const key = new THREE.DirectionalLight(0xffe2a8, 2.2);
      key.position.set(-5, 6, 7);
      scene.add(key);
      const rim = new THREE.DirectionalLight(secondary, 1.7);
      rim.position.set(6, 2, -5);
      scene.add(rim);

      const floorGrid = new THREE.GridHelper(24, 48, 0x16283f, 0x0d1622);
      floorGrid.position.y = -2.58;
      floorGrid.material.transparent = true;
      floorGrid.material.opacity = 0.13;
      scene.add(floorGrid);

      {
        const n = 460;
        const pos = new Float32Array(n * 3);
        for (let i = 0; i < n; i++) {
          const r = 11 + hash(i + 9) * 9;
          const th = hash(i + 31) * Math.PI * 2;
          const ph = Math.acos(2 * hash(i + 77) - 1);
          pos[i * 3] = r * Math.sin(ph) * Math.cos(th);
          pos[i * 3 + 1] = r * Math.cos(ph) * 0.55;
          pos[i * 3 + 2] = -Math.abs(r * Math.sin(ph) * Math.sin(th)) - 3;
        }
        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute("position", new THREE.BufferAttribute(pos, 3));
        scene.add(
          new THREE.Points(
            geometry,
            new THREE.PointsMaterial({
              color: 0x54749c,
              size: 0.035,
              transparent: true,
              opacity: 0.56,
            }),
          ),
        );
      }

      function makeRadialSprite(scale) {
        const c = document.createElement("canvas");
        c.width = c.height = 256;
        const ctx = c.getContext("2d");
        const grad = ctx.createRadialGradient(128, 128, 4, 128, 128, 128);
        grad.addColorStop(0, "rgba(255,224,138,0.34)");
        grad.addColorStop(0.38, "rgba(74,144,217,0.13)");
        grad.addColorStop(1, "rgba(0,0,0,0)");
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, 256, 256);
        const tex = new THREE.CanvasTexture(c);
        tex.colorSpace = THREE.SRGBColorSpace;
        const sprite = new THREE.Sprite(
          new THREE.SpriteMaterial({
            map: tex,
            transparent: true,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
            opacity: 0,
          }),
        );
        sprite.scale.set(scale, scale, 1);
        return sprite;
      }

      const glow = makeRadialSprite(7.2);
      glow.position.set(0, 0.62, -1.1);
      scene.add(glow);

      const ringGroup = new THREE.Group();
      ringGroup.position.set(0, 0.62, -0.72);
      scene.add(ringGroup);
      const outerRingMaterial = new THREE.MeshBasicMaterial({
        color: secondary,
        transparent: true,
        opacity: 0,
      });
      const outerRing = new THREE.Mesh(
        new THREE.TorusGeometry(2.58, 0.018, 10, 180),
        outerRingMaterial,
      );
      ringGroup.add(outerRing);
      const innerRingMaterial = new THREE.MeshBasicMaterial({
        color: accent,
        transparent: true,
        opacity: 0,
      });
      const innerRing = new THREE.Mesh(
        new THREE.TorusGeometry(2.08, 0.02, 10, 160),
        innerRingMaterial,
      );
      innerRing.rotation.set(0.08, 0, -0.12);
      ringGroup.add(innerRing);

      const waveGroup = new THREE.Group();
      waveGroup.position.set(0, -2.42, -0.15);
      scene.add(waveGroup);
      const waveBars = [];
      {
        const count = 33;
        const mid = (count - 1) / 2;
        const geo = new THREE.BoxGeometry(0.11, 1, 0.11);
        geo.translate(0, 0.5, 0);
        for (let i = 0; i < count; i++) {
          const distance = Math.abs(i - mid) / mid;
          const centerWeight = 1 - distance;
          const baseColor = secondary.clone().lerp(accent, centerWeight * 0.72);
          if (distance > 0.82) baseColor.lerp(muted, 0.35);
          const material = new THREE.MeshStandardMaterial({
            color: baseColor,
            emissive: baseColor.clone().multiplyScalar(0.1),
            metalness: 0.42,
            roughness: 0.34,
            transparent: true,
            opacity: 0,
          });
          const bar = new THREE.Mesh(geo, material);
          bar.position.x = (i - mid) * 0.245;
          bar.scale.y = 0.001;
          waveGroup.add(bar);
          waveBars.push({ bar, material, baseColor, centerWeight, index: i });
        }
      }

      function renderAt(rawT) {
        const t = Math.max(0, Math.min(DURATION, Number(rawT) || 0));
        const u = DURATION > 0 ? t / DURATION : 0;

        const cameraPush = easeOut(seg(u, 0, 0.55));
        camera.position.set(0, lerp(0.32, 0.18, cameraPush), lerp(8.9, 8.18, cameraPush));
        camera.lookAt(0, 0, 0);

        const stageIn = easeOut(seg(u, 0.04, 0.22));
        const responseP = hasResponse ? easeOut(seg(u, 0.52, 0.64)) : 0;
        glow.material.opacity = 0.62 * stageIn;
        outerRingMaterial.opacity = 0.42 * stageIn;
        innerRingMaterial.opacity = 0.62 * stageIn;
        ringGroup.rotation.z = t * 0.035;
        innerRing.rotation.z = -0.12 - t * 0.02;
        const ringScale = 0.86 + 0.14 * stageIn + Math.sin(t * 0.55) * 0.008;
        ringGroup.scale.set(ringScale, ringScale, ringScale);

        waveBars.forEach((entry) => {
          const i = entry.index;
          const responseLift = responseP * 0.16 * Math.sin(t * 4.1 + i * 0.9);
          const wave =
            0.42 +
            0.3 * Math.sin(t * 2.1 + i * 0.62) +
            0.2 * Math.sin(t * 3.7 + i * 1.17) +
            0.16 * hash(i + 3) +
            responseLift;
          const height =
            Math.max(0.16, Math.min(1.02, wave)) *
            (0.42 + 0.58 * entry.centerWeight) *
            stageIn;
          entry.bar.scale.y = Math.max(0.001, height);
          entry.material.opacity = (0.48 + 0.42 * entry.centerWeight) * stageIn;
          entry.material.color
            .copy(entry.baseColor)
            .lerp(accent, responseP * entry.centerWeight * 0.55);
        });

        renderer.render(scene, camera);
      }

      window.addEventListener("hf-seek", (e) => renderAt(e.detail.time));
      window.__hfThreeRender = () => renderAt(window.__hfThreeTime || 0);
      renderAt(0);

      const tl = gsap.timeline({ paused: true });
      tl.to({ v: 0 }, { v: 1, duration: DURATION, ease: "none" }, 0);
      window.__timelines["quote-stage"] = tl;
    })();
  </script>
</template>
