  <script>
    (function () {
      const DURATION = __DURATION__;
      const defaults = {
        closing_line_1: "THIS STORY ENDS",
        closing_line_2: "THE NEXT ONE BEGINS",
        closing_line_3: "",
        accent_line: 2,
        closing_line_1_size: 108,
        closing_line_2_size: 108,
        closing_line_3_size: 56,
        tagline: "Built locally, frame by frame.",
        brand_label: "SIDD STUDIO",
        glyph: "S",
        credit_line_1: "SCRIPT TO MOTION",
        credit_line_2: "RENDERED LOCALLY",
        credit_line_3: "1080P · 60 FPS",
        cta_label: "NEXT STORY",
      };
      let runtimeVariables = {};
      try {
        runtimeVariables = window.__hyperframes?.getVariables?.() || {};
      } catch (error) {
        runtimeVariables = {};
      }
      const vars = { ...defaults, ...runtimeVariables };

      const lineIds = ["outro-line-1", "outro-line-2", "outro-line-3"];
      const accentLine = Math.max(1, Math.min(3, Number(vars.accent_line) || defaults.accent_line));
      lineIds.forEach((id, index) => {
        const element = document.getElementById(id);
        if (!element) return;
        const key = `closing_line_${index + 1}`;
        const text = String(vars[key] ?? "");
        const requested = Number(vars[`${key}_size`]) || defaults[`${key}_size`];
        const fitted = Math.floor(1480 / (0.62 * Math.max(1, Array.from(text).length)));
        element.style.display = text.trim() ? "block" : "none";
        element.style.fontSize = `${Math.max(56, Math.min(requested, fitted))}px`;
        element.classList.toggle("is-accent", index + 1 === accentLine);
      });

      const tagline = String(vars.tagline || "");
      const taglineEl = document.getElementById("outro-tagline");
      if (taglineEl) {
        taglineEl.style.display = tagline.trim() ? "block" : "none";
        if (Array.from(tagline).length > 46) taglineEl.style.fontSize = "36px";
      }
      const brandEl = document.getElementById("outro-brand");
      if (brandEl && !String(vars.brand_label || "").trim()) {
        brandEl.style.display = "none";
      }
      const emblem = document.getElementById("outro-emblem");
      if (emblem && !String(vars.glyph || "").trim()) {
        emblem.style.display = "none";
      }

      const creditTexts = [1, 2, 3].map((i) => String(vars[`credit_line_${i}`] || ""));
      const hasCredits = creditTexts.some((text) => text.trim());
      const credits = document.getElementById("outro-credits");
      if (credits && !hasCredits) credits.style.display = "none";
      creditTexts.forEach((text, index) => {
        const element = document.getElementById(`outro-credit-${index + 1}`);
        if (element) element.style.display = text.trim() ? "inline" : "none";
      });
      const sep1 = document.getElementById("outro-credit-sep-1");
      if (sep1) {
        sep1.style.display = creditTexts[0].trim() && (creditTexts[1].trim() || creditTexts[2].trim()) ? "inline" : "none";
      }
      const sep2 = document.getElementById("outro-credit-sep-2");
      if (sep2) {
        sep2.style.display = creditTexts[1].trim() && creditTexts[2].trim() ? "inline" : "none";
      }

      const cta = document.getElementById("outro-cta");
      if (cta && !String(vars.cta_label || "").trim()) cta.style.display = "none";

      const at = (fraction) => Math.max(0, fraction * DURATION);
      const span = (fraction) => Math.max(0.18, fraction * DURATION);
      const exitAt = Math.max(at(0.9), DURATION - 0.32);
      const exitSpan = Math.min(0.26, Math.max(0.16, DURATION - exitAt - 0.03));

      const tl = gsap.timeline({ paused: true });
      tl.fromTo(
        "#outro-kicker-anim",
        { opacity: 0, y: -18 },
        { opacity: 1, y: 0, duration: span(0.06), ease: "power3.out" },
        at(0.025),
      );
      tl.fromTo(
        "#outro-emblem",
        { opacity: 0, scale: 0.76, filter: "blur(12px)" },
        {
          opacity: 1,
          scale: 1,
          filter: "blur(0px)",
          duration: span(0.09),
          ease: "power3.out",
          transformOrigin: "50% 50%",
        },
        at(0.08),
      );
      tl.fromTo(
        "#outro-line-1",
        { opacity: 0, y: 44, filter: "blur(10px)" },
        { opacity: 1, y: 0, filter: "blur(0px)", duration: span(0.075), ease: "power4.out" },
        at(0.16),
      );
      tl.fromTo(
        "#outro-line-2",
        { opacity: 0, y: 44, filter: "blur(10px)" },
        { opacity: 1, y: 0, filter: "blur(0px)", duration: span(0.075), ease: "power4.out" },
        at(0.24),
      );
      tl.fromTo(
        "#outro-line-3",
        { opacity: 0, y: 44, filter: "blur(10px)" },
        { opacity: 1, y: 0, filter: "blur(0px)", duration: span(0.075), ease: "power4.out" },
        at(0.32),
      );
      tl.fromTo(
        "#outro-tagline",
        { opacity: 0, y: 28 },
        { opacity: 1, y: 0, duration: span(0.065), ease: "power3.out" },
        at(0.38),
      );
      tl.fromTo(
        "#outro-brand",
        { opacity: 0, y: 18 },
        { opacity: 1, y: 0, duration: span(0.055), ease: "power3.out" },
        at(0.44),
      );
      tl.fromTo(
        "#outro-credits-anim",
        { opacity: 0, y: 28 },
        { opacity: 0.92, y: 0, duration: span(0.065), ease: "power3.out" },
        at(0.45),
      );
      tl.fromTo(
        "#outro-cta-anim",
        { opacity: 0, y: 30, scale: 0.96 },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: span(0.07),
          ease: "power4.out",
          transformOrigin: "50% 50%",
        },
        at(0.58),
      );
      tl.to(
        [
          "#outro-kicker-anim",
          "#outro-emblem",
          ".outro-line",
          "#outro-tagline",
          "#outro-brand",
          "#outro-credits-anim",
          "#outro-cta-anim",
        ],
        { opacity: 0, y: -14, filter: "blur(5px)", duration: exitSpan, ease: "power3.in" },
        exitAt,
      );
      window.__timelines["outro-text"] = tl;
    })();
  </script>
