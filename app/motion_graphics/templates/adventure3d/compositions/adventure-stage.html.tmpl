          phase: fract(i * 0.173),
          side: i % 2 ? 1 : -1,
          scale: 0.75 + hash(i + 4301) * 0.6,
        });
      }
      const explosions = [];
      [[-18, -12], [8, -14], [31, -11], [-43, 0], [52, -16]].forEach(([x, z], i) => {
        const sprite = makeSprite(glowTexture, 0xff9a3c, 0, THREE.AdditiveBlending);
        const y = terrainHeight(x, z) + 1.2;
        sprite.position.set(x, y, z);
        scene.add(sprite);
        explosions.push({ sprite, x, y, z, period: 3.8 + i * 0.63, offset: i * 1.27 });
      });
      const clouds = [];
      for (let i = 0; i < 11; i++) {
        const sprite = makeSprite(smokeTexture, 0xd7dee6, 0.13 + hash(i + 4401) * 0.07);
        sprite.position.set(-110 + hash(i + 4431) * 220, 31 + hash(i + 4461) * 14, -92 - hash(i + 4491) * 35);
        sprite.scale.set(30 + hash(i + 4521) * 24, 9 + hash(i + 4551) * 5, 1);
        sprite.material.fog = false;
        scene.add(sprite);
        clouds.push({ sprite, offset: hash(i + 4581) * 220, y: sprite.position.y, z: sprite.position.z });
      }
      const sunSprite = makeSprite(glowTexture, 0xffd9a0, 0.52, THREE.AdditiveBlending);
      sunSprite.position.set(-78, 43, -112);
      sunSprite.scale.set(34, 34, 1);
      sunSprite.material.fog = false;
      scene.add(sunSprite);

      let ashGeometry;
      let ashBase;
      let ashPhase;
      {
        const count = 520;
        const positions = new Float32Array(count * 3);
        ashBase = new Float32Array(count * 3);
        ashPhase = new Float32Array(count);
        for (let i = 0; i < count; i++) {
          const x = -82 + hash(i + 5001) * 164;
          const y = hash(i + 5031) * 23;
          const z = -48 + hash(i + 5061) * 78;
          positions.set([x, y, z], i * 3);
          ashBase.set([x, y, z], i * 3);
          ashPhase[i] = hash(i + 5091) * Math.PI * 2;
        }
        ashGeometry = new THREE.BufferGeometry();
        ashGeometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
        const ash = new THREE.Points(
          ashGeometry,
          new THREE.PointsMaterial({
            color: 0xd8d2c4,
            size: 0.075,
            transparent: true,
            opacity: 0.36,
            depthWrite: false,
          }),
        );
        scene.add(ash);
      }

      const tracers = [];
      function makeTracer(sx, sy, sz, tx, ty, tz, phase) {
        const material = new THREE.MeshBasicMaterial({
          color: 0xffb15e,
          transparent: true,
          opacity: 0,
          depthWrite: false,
        });
        const item = box(scene, material, 1.35, 0.035, 0.035, sx, sy, sz);
        item.castShadow = false;
        item.receiveShadow = false;
        const start = V3(sx, sy, sz);
        const end = V3(tx, ty, tz);
        item.rotation.y = -Math.atan2(end.z - start.z, end.x - start.x);
        item.rotation.z = Math.atan2(end.y - start.y, Math.hypot(end.x - start.x, end.z - start.z));
        tracers.push({ item, material, start, end, phase });
      }
      makeTracer(-18, 1.7, 8.5, -8, 1.3, -13, 0.05);
      makeTracer(-12, 1.6, 8.5, 2, 1.5, -13, 0.42);
      makeTracer(17, 1.5, -13, 27, 1.2, -22, 0.68);
      makeTracer(36, 1.5, -12, 46, 1.1, -21, 0.22);
      makeTracer(5, 2.2, -7, 18, 2.7, -19, 0.83);

      const cameraPaths = {
        montage: {
          pos: [[-54,18,49],[-39,9,29],[-25,4.4,16],[-10,5.2,18],[8,7,23],[22,8,10],[34,6.5,-2],[43,8,-10]],
          target: [[-25,1,-8],[-24,1.3,-2],[-18,1.5,0],[-3,1.2,5],[6,2,-4],[24,1,-23],[30,1,-26],[31,1,-28]],
        },
        battlefield: {
          pos: [[-50,16,43],[-35,7,24],[-22,3.6,13],[-8,5,18],[5,8,27]],
          target: [[-25,1,-6],[-23,1.2,-1],[-14,1.5,3],[3,2,-5],[-12,1,-15]],
        },
        invasion: {
          pos: [[-56,11,29],[-36,5.2,17],[-16,4.2,15],[5,5.2,17],[25,8,24]],
          target: [[-36,1,5],[-19,1,5],[0,1,5],[16,1,5],[29,1,-3]],
        },
        coastal: {
          pos: [[-4,13,19],[10,7,4],[22,5,-6],[34,6.5,-8],[43,8,-10]],
          target: [[18,0,-25],[25,0,-27],[32,0,-28],[30,1,-27],[31,1,-28]],
        },
      };
      const selectedPath = cameraPaths[environment] || cameraPaths.montage;
      const cameraCurve = new THREE.CatmullRomCurve3(
        selectedPath.pos.map(([x, y, z]) => V3(x, y, z)),
        false,
        "catmullrom",
        0.16,
      );
      const targetCurve = new THREE.CatmullRomCurve3(
        selectedPath.target.map(([x, y, z]) => V3(x, y, z)),
        false,
        "catmullrom",
        0.16,
      );
      const cameraPos = new THREE.Vector3();
      const cameraTarget = new THREE.Vector3();

      let buildStats = { objects: 0, meshes: 0, sprites: 0, points: 0 };
      scene.traverse((object) => {
        buildStats.objects++;
        if (object.isMesh) buildStats.meshes++;
        if (object.isSprite) buildStats.sprites++;
        if (object.isPoints) buildStats.points++;
      });

      function firingPulse(t, period, offset) {
        const p = fract((t + offset) / Math.max(0.8, period / intensity));
        return {
          p,
          flash: p < 0.035 ? 1 - p / 0.035 : 0,
          recoil: Math.exp(-p * 24) * 0.24,
        };
      }
      function animateSoldierLimbs(soldier, phase, amount = 1) {
        const swing = Math.sin(phase) * 0.55 * amount;
        soldier.legs[0].rotation.z = swing;
        soldier.legs[1].rotation.z = -swing;
        soldier.arms[0].rotation.z = -swing * 0.72;
        soldier.arms[1].rotation.z = swing * 0.72 - 0.22;
      }

      function renderAt(rawT) {
        const t = Math.max(0, Math.min(DURATION, Number(rawT) || 0));
        const u = DURATION > 0 ? t / DURATION : 0;
        const actionT = t * intensity;

        // Convoy and road infantry.
        convoy.forEach((vehicle) => {
          const x = -84 + mod(vehicle.offset + actionT * 3.45, 166);
          const z = 5;
          const y = terrainHeight(x, z) + 0.03;
          vehicle.group.position.set(x, y + Math.abs(Math.sin(actionT * 5 + vehicle.offset)) * 0.025, z);
          const slope = (terrainHeight(x + 1.6, z) - terrainHeight(x - 1.6, z)) / 3.2;
          vehicle.group.rotation.z = Math.atan(slope) * 0.55;
          if (vehicle.turret) {
            vehicle.turret.rotation.y = Math.sin(actionT * 0.32 + vehicle.offset) * 0.22;
            const pulse = firingPulse(t, 5.4, vehicle.firingOffset);
            vehicle.barrelGroup.position.x = vehicle.baseBarrelX - pulse.recoil;
            vehicle.flash.material.opacity = pulse.flash * 0.88;
            vehicle.flash.material.rotation = vehicle.offset + t * 0.4;
          }
        });
        const leadX = convoy[0]?.group.position.x || 0;
        marchingSoldiers.forEach((soldier) => {
          const x = -84 + mod(soldier.offset + actionT * 3.1, 166);
          const phase = actionT * 6.2 + soldier.phase;
          soldier.group.position.set(x, terrainHeight(x, soldier.lane) + Math.abs(Math.sin(phase)) * 0.055, soldier.lane);
          soldier.group.rotation.y = 0;
          animateSoldierLimbs(soldier, phase, 1);
        });

        // Stationary/hero armor and infantry.
        heroTanks.forEach((tank, i) => {
          const travel = i === 0 ? Math.min(actionT * 0.24, 4.2) : Math.sin(actionT * 0.1 + i) * 0.25;
          const x = tank.baseX + travel;
          tank.group.position.x = x;
          tank.group.position.y = terrainHeight(x, tank.baseZ) + Math.abs(Math.sin(actionT * 3 + i)) * 0.018;
          tank.turret.rotation.y = Math.sin(actionT * 0.28 + i * 1.7) * 0.3;
          const pulse = firingPulse(t, 4.8 + i * 0.7, tank.firingOffset);
          tank.barrelGroup.position.x = tank.baseBarrelX - pulse.recoil;
          tank.flash.material.opacity = pulse.flash * 0.92;
          tank.flash.material.rotation = i * 1.3 + t * 0.35;
        });
        crouchedSoldiers.forEach((soldier, i) => {
          soldier.torso.rotation.z = -0.34 + Math.sin(actionT * 0.9 + soldier.phase) * 0.035;
          soldier.arms[0].rotation.z = -0.62 + Math.sin(actionT * 1.1 + i) * 0.035;
          soldier.arms[1].rotation.z = -0.95 + Math.cos(actionT * 1.05 + i) * 0.03;
        });
        beachSoldiers.forEach((soldier, i) => {
          const local = fract(u * 1.08 + soldier.phase);
          const z = -25 + local * 12.5;
          const x = soldier.baseX + Math.sin(local * 5 + i) * 0.7;
          const phase = actionT * 5.3 + i * 0.9;
          soldier.group.position.set(x, terrainHeight(x, z) + Math.abs(Math.sin(phase)) * 0.045, z);
          animateSoldierLimbs(soldier, phase, 0.88);
        });

        artillery.forEach((item, i) => {
          const pulse = firingPulse(t, 5.8 + i * 0.6, item.firingOffset);
          item.barrelGroup.position.x = item.baseBarrelX - pulse.recoil * 1.25;
          item.flash.material.opacity = pulse.flash * 0.9;
          item.flash.material.rotation = i * 0.9 + t * 0.3;
        });

        // Air and sea elements.
        planes.forEach((plane, i) => {
          const x = -95 + mod(plane.offset + actionT * (8.5 - i * 0.7), 195);
          plane.group.position.set(x, plane.y + Math.sin(actionT * 0.65 + plane.phase) * 0.35, plane.z);
          plane.group.rotation.set(Math.sin(actionT * 0.45 + plane.phase) * 0.08, 0, Math.sin(actionT * 0.3 + plane.phase) * 0.025);
          plane.prop.rotation.x = actionT * 42 + plane.phase;
        });
        ships.forEach((ship) => {
          ship.group.position.set(
            ship.baseX + Math.sin(actionT * 0.05 + ship.phase) * 1.2,
            -0.55 + Math.sin(actionT * 0.65 + ship.phase) * 0.08,
            ship.baseZ,
          );
          ship.group.rotation.set(
            Math.sin(actionT * 0.55 + ship.phase) * 0.012,
            0,
            Math.sin(actionT * 0.45 + ship.phase) * 0.01,
          );
        });
        landingCraft.forEach((craft) => {
          craft.group.position.set(
            craft.baseX,
            -0.5 + Math.sin(actionT * 0.9 + craft.phase) * 0.09,
            craft.baseZ + u * 7.5,
          );
          craft.group.rotation.set(
            Math.sin(actionT * 0.75 + craft.phase) * 0.02,
            -Math.PI / 2,
            Math.sin(actionT * 0.6 + craft.phase) * 0.015,
          );
        });

        // Ocean waves and waving flags.
        {
          const pos = oceanGeometry.attributes.position;
          for (let i = 0; i < pos.count; i++) {
            const x = oceanBase[i * 3];
            const z = oceanBase[i * 3 + 2];
            pos.setY(i, Math.sin(x * 0.18 + actionT * 1.55) * 0.07 + Math.cos(z * 0.34 - actionT * 1.15) * 0.05);
          }
          pos.needsUpdate = true;
          oceanGeometry.computeVertexNormals();
        }
        flags.forEach((flag) => {
          const pos = flag.geometry.attributes.position;
          for (let i = 0; i < pos.count; i++) {
            const x = flag.base[i * 3];
            const y = flag.base[i * 3 + 1];
            const wave = Math.sin(x * 2.15 - actionT * 6 + flag.phase) * 0.1 * (x / 3) + Math.sin(y * 3 + actionT * 4) * 0.018;
            pos.setZ(i, wave);
          }
          pos.needsUpdate = true;
          flag.geometry.computeVertexNormals();
        });

        // Atmosphere and battlefield effects.
        smokePuffs.forEach((puff) => {
          const p = fract(actionT * 0.055 + puff.phase);
          const scale = (3 + p * 11) * puff.scale;
          puff.sprite.position.set(
            puff.source.x + p * 5 + Math.sin(actionT * 0.7 + puff.phase * 9) * 0.4,
            puff.source.y + p * 13,
            puff.source.z - p * 1.6,
          );
          puff.sprite.scale.set(scale, scale * 0.78, 1);
          puff.sprite.material.opacity = 0.34 * (1 - p) * smoothstep(0, 0.12, p) * Math.min(1.25, intensity);
          puff.sprite.material.rotation = puff.phase * 2 + actionT * 0.018;
        });
        dustPuffs.forEach((puff) => {
          const vehicle = convoy[puff.vehicleIndex];
          if (!vehicle) return;
          const p = fract(actionT * 0.48 + puff.phase);
          const vp = vehicle.group.position;
          const scale = (1.4 + p * 4.2) * puff.scale;
          puff.sprite.position.set(vp.x - 3 - p * 5, vp.y + 0.45 + p * 1.5, vp.z + puff.side * (0.7 + p * 1.1));
          puff.sprite.scale.set(scale, scale * 0.62, 1);
          puff.sprite.material.opacity = 0.2 * (1 - p) * Math.min(1.2, intensity);
        });
        explosions.forEach((explosion, i) => {
          const p = fract((t + explosion.offset) / Math.max(1.4, explosion.period / intensity));
          let opacity = 0;
          let scale = 1;
          let lightIntensity = 0;
          if (p < 0.16) {
            const local = p / 0.16;
            opacity = (1 - local) * 0.88;
            scale = 2 + local * 9.5;
            lightIntensity = (1 - local) * 28;
            explosion.sprite.position.y = explosion.y + local * 2.3;
          }
          explosion.sprite.material.opacity = opacity;
          explosion.sprite.scale.set(scale, scale, 1);
          explosion.sprite.material.rotation = i * 0.7 + t * 0.25;
          if (i < explosionLights.length) {
            explosionLights[i].position.set(explosion.x, explosion.y + 1.5, explosion.z);
            explosionLights[i].intensity = lightIntensity;
          }
        });
        clouds.forEach((cloud) => {
          cloud.sprite.position.x = -118 + mod(cloud.offset + t * 0.55, 236);
        });
        {
          const pos = ashGeometry.attributes.position;
          for (let i = 0; i < ashPhase.length; i++) {
            const bx = ashBase[i * 3];
            const by = ashBase[i * 3 + 1];
            const bz = ashBase[i * 3 + 2];
            pos.setXYZ(
              i,
              bx + Math.sin(t * 0.55 + ashPhase[i]) * 0.45,
              0.25 + mod(by - t * 0.55, 23),
              bz + Math.cos(t * 0.4 + ashPhase[i]) * 0.3,
            );
          }
          pos.needsUpdate = true;
        }
        tracers.forEach((tracer) => {
          const p = fract(actionT * 0.34 + tracer.phase);
          tracer.item.position.lerpVectors(tracer.start, tracer.end, p);
          tracer.item.position.y += Math.sin(p * Math.PI) * 0.35;
          tracer.material.opacity = p > 0.04 && p < 0.96 ? 0.58 * Math.min(1, intensity) : 0;
        });

        // Cinematic camera path and move modifiers.
        cameraCurve.getPoint(clamp01(u), cameraPos);
        targetCurve.getPoint(clamp01(u), cameraTarget);
        let fov = lerp(49, 42, smoothstep(0, 1, u));
        if (cameraMove === "aerial") {
          cameraPos.y += 10;
          cameraTarget.y -= 0.4;
          fov = 46;
        } else if (cameraMove === "push_in") {
          cameraPos.lerp(cameraTarget, 0.25 * smoothstep(0, 1, u));
          fov = lerp(51, 37, smoothstep(0, 1, u));
        } else if (cameraMove === "pan") {
          cameraTarget.x += Math.sin(u * Math.PI) * 10;
          fov = 45;
        } else if (cameraMove === "tracking") {
          cameraTarget.x = lerp(cameraTarget.x, leadX, 0.38);
          cameraPos.x += (leadX + 35) * 0.075;
          fov = 44;
        }
        cameraPos.x += Math.sin(t * 0.65) * 0.075;
        cameraPos.y += Math.sin(t * 0.9 + 0.4) * 0.05;
        cameraTarget.x += Math.sin(t * 0.5) * 0.06;
        camera.position.copy(cameraPos);
        camera.lookAt(cameraTarget);
        if (Math.abs(camera.fov - fov) > 0.01) {
          camera.fov = fov;
          camera.updateProjectionMatrix();
        }

        renderer.render(scene, camera);
        window.__hfAdventureStats = {
          ...buildStats,
          calls: renderer.info.render.calls,
          triangles: renderer.info.render.triangles,
          environment,
          cameraMove,
          intensity,
        };
      }

      window.addEventListener("hf-seek", (e) => renderAt(e.detail.time));
      window.__hfThreeRender = () => renderAt(window.__hfThreeTime || 0);
      renderAt(0);

      const tl = gsap.timeline({ paused: true });
      tl.to({ v: 0 }, { v: 1, duration: DURATION, ease: "none" }, 0);
      window.__timelines["adventure-stage"] = tl;
    })();
  </script>
</template>
