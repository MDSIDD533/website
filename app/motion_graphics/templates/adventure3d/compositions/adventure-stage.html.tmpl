<template>
  <style>
    #root {
      position: absolute;
      inset: 0;
      overflow: hidden;
      background: #20241c;
    }
    #adventure-stage-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
  </style>
  <div
    id="root"
    data-composition-id="adventure-stage"
    data-width="1920"
    data-height="1080"
    data-composition-variables='[{"id":"environment","type":"enum","label":"3D environment","default":"montage","options":[{"value":"battlefield","label":"Battlefield"},{"value":"invasion","label":"Invasion convoy"},{"value":"coastal","label":"Coastal landing"},{"value":"montage","label":"Land-sea-air montage"}]},{"id":"camera_move","type":"enum","label":"Camera move","default":"cinematic","options":[{"value":"cinematic","label":"Cinematic path"},{"value":"push_in","label":"Push in"},{"value":"pan","label":"Pan"},{"value":"aerial","label":"Aerial"},{"value":"tracking","label":"Tracking"}]},{"id":"intensity","type":"number","label":"Action intensity","default":1,"min":0.3,"max":2,"step":0.1},{"id":"sky_color","type":"color","label":"Sky color","default":"#243447"},{"id":"ground_color","type":"color","label":"Ground color","default":"#20241c"},{"id":"accent_color","type":"color","label":"Accent color","default":"#e0a458"},{"id":"secondary_color","type":"color","label":"Secondary color","default":"#6e93b8"},{"id":"muted_color","type":"color","label":"Muted color","default":"#77806f"}]'
  >
    <canvas id="adventure-stage-canvas" class="clip" data-start="0" data-duration="__DURATION__" data-track-index="0"></canvas>
  </div>
  <script src="assets/lib/three.min.js"></script>
  <script>
    (function () {
      "use strict";
      const DURATION = __DURATION__;
      const defaults = {
        environment: "montage",
        camera_move: "cinematic",
        intensity: 1,
        sky_color: "#243447",
        ground_color: "#20241c",
        accent_color: "#e0a458",
        secondary_color: "#6e93b8",
        muted_color: "#77806f",
      };
      let runtimeVariables = {};
      try {
        runtimeVariables = window.__hyperframes?.getVariables?.() || {};
      } catch (error) {
        runtimeVariables = {};
      }
      const vars = { ...defaults, ...runtimeVariables };
      const environment = ["battlefield", "invasion", "coastal", "montage"].includes(
        String(vars.environment),
      )
        ? String(vars.environment)
        : defaults.environment;
      const cameraMove = ["cinematic", "push_in", "pan", "aerial", "tracking"].includes(
        String(vars.camera_move),
      )
        ? String(vars.camera_move)
        : defaults.camera_move;
      const intensity = Math.max(0.3, Math.min(2, Number(vars.intensity) || 1));

      const clamp01 = (v) => Math.max(0, Math.min(1, v));
      const fract = (v) => v - Math.floor(v);
      const mod = (v, n) => ((v % n) + n) % n;
      const lerp = (a, b, v) => a + (b - a) * v;
      const smoothstep = (a, b, x) => {
        const t = clamp01((x - a) / (b - a));
        return t * t * (3 - 2 * t);
      };
      const hash = (i) => fract(Math.sin(i * 127.1 + 311.7) * 43758.5453123);
      const hash2 = (x, z) =>
        fract(Math.sin(x * 127.1 + z * 311.7) * 43758.5453123);
      const V3 = (x, y, z) => new THREE.Vector3(x, y, z);

      const skyColor = new THREE.Color(vars.sky_color);
      const groundColor = new THREE.Color(vars.ground_color);
      const accentColor = new THREE.Color(vars.accent_color);
      const secondaryColor = new THREE.Color(vars.secondary_color);
      const mutedColor = new THREE.Color(vars.muted_color);
      const fogColor = skyColor.clone().lerp(new THREE.Color(0x8b959d), 0.38);

      const canvas = document.getElementById("adventure-stage-canvas");
      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: false,
        powerPreference: "high-performance",
      });
      renderer.setPixelRatio(1);
      renderer.setSize(1920, 1080, false);
      renderer.setClearColor(fogColor, 1);
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.18;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      const scene = new THREE.Scene();
      scene.background = fogColor;
      scene.fog = new THREE.Fog(fogColor, 48, 190);
      const camera = new THREE.PerspectiveCamera(47, 1920 / 1080, 0.1, 430);

      // Local canvas reflections keep the metal/paint response rich without
      // any external HDR file.
      {
        const ec = document.createElement("canvas");
        ec.width = 1024;
        ec.height = 512;
        const ex = ec.getContext("2d");
        const lg = ex.createLinearGradient(0, 0, 0, 512);
        lg.addColorStop(0, "#5f7488");
        lg.addColorStop(0.48, "#8b959d");
        lg.addColorStop(0.52, "#45463a");
        lg.addColorStop(1, "#141713");
        ex.fillStyle = lg;
        ex.fillRect(0, 0, 1024, 512);
        const rg = ex.createRadialGradient(270, 175, 8, 270, 175, 320);
        rg.addColorStop(0, "rgba(255,232,175,0.95)");
        rg.addColorStop(1, "rgba(255,232,175,0)");
        ex.fillStyle = rg;
        ex.fillRect(0, 0, 1024, 512);
        const etex = new THREE.CanvasTexture(ec);
        etex.mapping = THREE.EquirectangularReflectionMapping;
        etex.colorSpace = THREE.SRGBColorSpace;
        const pmrem = new THREE.PMREMGenerator(renderer);
        scene.environment = pmrem.fromEquirectangular(etex).texture;
        etex.dispose();
        pmrem.dispose();
      }

      const hemi = new THREE.HemisphereLight(0xd6e0ea, 0x353321, 1.55);
      scene.add(hemi);
      const sun = new THREE.DirectionalLight(0xffe2b0, 2.9);
      sun.position.set(-42, 48, 34);
      sun.castShadow = true;
      sun.shadow.mapSize.set(2048, 2048);
      sun.shadow.camera.left = -105;
      sun.shadow.camera.right = 105;
      sun.shadow.camera.top = 85;
      sun.shadow.camera.bottom = -85;
      sun.shadow.camera.near = 5;
      sun.shadow.camera.far = 180;
      sun.shadow.bias = -0.00045;
      sun.target.position.set(0, 0, -12);
      scene.add(sun);
      scene.add(sun.target);
      const rim = new THREE.DirectionalLight(secondaryColor, 1.25);
      rim.position.set(55, 18, -48);
      scene.add(rim);
      const explosionLights = [
        new THREE.PointLight(0xff8a3d, 0, 42, 1.7),
        new THREE.PointLight(0xffa04a, 0, 38, 1.7),
      ];
      explosionLights.forEach((light) => scene.add(light));

      // Gradient sky dome.
      {
        const skyMaterial = new THREE.ShaderMaterial({
          side: THREE.BackSide,
          depthWrite: false,
          uniforms: {
            topColor: { value: skyColor },
            horizonColor: { value: new THREE.Color(0x929fa8) },
            bottomColor: { value: groundColor },
          },
          vertexShader: `
            varying vec3 vWorldPosition;
            void main() {
              vec4 worldPosition = modelMatrix * vec4(position, 1.0);
              vWorldPosition = worldPosition.xyz;
              gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
            }
          `,
          fragmentShader: `
            uniform vec3 topColor;
            uniform vec3 horizonColor;
            uniform vec3 bottomColor;
            varying vec3 vWorldPosition;
            void main() {
              float h = normalize(vWorldPosition).y;
              vec3 sky = mix(horizonColor, topColor, smoothstep(-0.02, 0.28, h));
              vec3 col = mix(bottomColor, sky, smoothstep(-0.18, 0.02, h));
              gl_FragColor = vec4(col, 1.0);
            }
          `,
        });
        const dome = new THREE.Mesh(
          new THREE.SphereGeometry(250, 36, 18),
          skyMaterial,
        );
        dome.renderOrder = -10;
        scene.add(dome);
      }

      const BOX = new THREE.BoxGeometry(1, 1, 1);
      const CYL = new THREE.CylinderGeometry(0.5, 0.5, 1, 18);
      const CYL_LOW = new THREE.CylinderGeometry(0.5, 0.5, 1, 10);
      const SPHERE = new THREE.SphereGeometry(0.5, 18, 12);
      const CONE = new THREE.ConeGeometry(0.5, 1, 14);

      function addMesh(parent, geometry, material, sx, sy, sz, x, y, z, rx = 0, ry = 0, rz = 0) {
        const item = new THREE.Mesh(geometry, material);
        item.scale.set(sx, sy, sz);
        item.position.set(x, y, z);
        item.rotation.set(rx, ry, rz);
        item.castShadow = true;
        item.receiveShadow = true;
        parent.add(item);
        return item;
      }
      const box = (p, m, w, h, d, x, y, z, rx, ry, rz) =>
        addMesh(p, BOX, m, w, h, d, x, y, z, rx, ry, rz);
      const cyl = (p, m, r, h, x, y, z, rx, ry, rz) =>
        addMesh(p, CYL, m, r * 2, h, r * 2, x, y, z, rx, ry, rz);
      const cylLow = (p, m, r, h, x, y, z, rx, ry, rz) =>
        addMesh(p, CYL_LOW, m, r * 2, h, r * 2, x, y, z, rx, ry, rz);
      const ball = (p, m, sx, sy, sz, x, y, z, rx, ry, rz) =>
        addMesh(p, SPHERE, m, sx, sy, sz, x, y, z, rx, ry, rz);
      const cone = (p, m, r, h, x, y, z, rx, ry, rz) =>
        addMesh(p, CONE, m, r * 2, h, r * 2, x, y, z, rx, ry, rz);

      const MAT = {
        olive: new THREE.MeshStandardMaterial({ color: 0x59613c, metalness: 0.34, roughness: 0.58 }),
        oliveDark: new THREE.MeshStandardMaterial({ color: 0x39402c, metalness: 0.28, roughness: 0.68 }),
        oliveLight: new THREE.MeshStandardMaterial({ color: 0x707650, metalness: 0.24, roughness: 0.62 }),
        track: new THREE.MeshStandardMaterial({ color: 0x24251f, metalness: 0.22, roughness: 0.86 }),
        metal: new THREE.MeshStandardMaterial({ color: 0x3e4547, metalness: 0.62, roughness: 0.42 }),
        darkMetal: new THREE.MeshStandardMaterial({ color: 0x252a2c, metalness: 0.55, roughness: 0.5 }),
        wood: new THREE.MeshStandardMaterial({ color: 0x6d5134, roughness: 0.9 }),
        canvas: new THREE.MeshStandardMaterial({ color: 0x777052, roughness: 0.92 }),
        uniform: new THREE.MeshStandardMaterial({ color: 0x5b6244, roughness: 0.94 }),
        uniformDark: new THREE.MeshStandardMaterial({ color: 0x414735, roughness: 0.96 }),
        skin: new THREE.MeshStandardMaterial({ color: 0xb08a68, roughness: 0.82 }),
        helmet: new THREE.MeshStandardMaterial({ color: 0x4c553d, metalness: 0.2, roughness: 0.62 }),
        stone: new THREE.MeshStandardMaterial({ color: 0x7b766b, roughness: 0.96 }),
        stoneDark: new THREE.MeshStandardMaterial({ color: 0x59554d, roughness: 1 }),
        brick: new THREE.MeshStandardMaterial({ color: 0x74584c, roughness: 0.98 }),
        roof: new THREE.MeshStandardMaterial({ color: 0x433a34, roughness: 0.95 }),
        leaf: new THREE.MeshStandardMaterial({ color: 0x3f5631, roughness: 1 }),
        trunk: new THREE.MeshStandardMaterial({ color: 0x4b3927, roughness: 1 }),
        sandbag: new THREE.MeshStandardMaterial({ color: 0x8b7958, roughness: 1 }),
        window: new THREE.MeshBasicMaterial({ color: 0x11161c }),
        ship: new THREE.MeshStandardMaterial({ color: 0x46545d, metalness: 0.42, roughness: 0.54 }),
        shipDark: new THREE.MeshStandardMaterial({ color: 0x2e393f, metalness: 0.38, roughness: 0.6 }),
        muted: new THREE.MeshStandardMaterial({ color: mutedColor, roughness: 0.9 }),
      };

      function makeGlowTexture() {
        const c = document.createElement("canvas");
        c.width = c.height = 256;
        const ctx = c.getContext("2d");
        const grad = ctx.createRadialGradient(128, 128, 2, 128, 128, 128);
        grad.addColorStop(0, "rgba(255,255,255,1)");
        grad.addColorStop(0.22, "rgba(255,255,255,0.55)");
        grad.addColorStop(0.58, "rgba(255,255,255,0.14)");
        grad.addColorStop(1, "rgba(255,255,255,0)");
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, 256, 256);
        const tex = new THREE.CanvasTexture(c);
        tex.colorSpace = THREE.SRGBColorSpace;
        return tex;
      }
      function makeSmokeTexture() {
        const c = document.createElement("canvas");
        c.width = c.height = 256;
        const ctx = c.getContext("2d");
        ctx.clearRect(0, 0, 256, 256);
        for (let i = 0; i < 34; i++) {
          const angle = hash(i + 401) * Math.PI * 2;
          const radius = hash(i + 433) * 62;
          const x = 128 + Math.cos(angle) * radius;
          const y = 128 + Math.sin(angle) * radius * 0.72;
          const r = 28 + hash(i + 467) * 54;
          const grad = ctx.createRadialGradient(x, y, 1, x, y, r);
          grad.addColorStop(0, "rgba(255,255,255,0.20)");
          grad.addColorStop(0.55, "rgba(255,255,255,0.08)");
          grad.addColorStop(1, "rgba(255,255,255,0)");
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, 256, 256);
        }
        const tex = new THREE.CanvasTexture(c);
        tex.colorSpace = THREE.SRGBColorSpace;
        return tex;
      }
      const glowTexture = makeGlowTexture();
      const smokeTexture = makeSmokeTexture();
      function makeSprite(texture, color, opacity, blending = THREE.NormalBlending) {
        const material = new THREE.SpriteMaterial({
          map: texture,
          color,
          transparent: true,
          opacity,
          depthWrite: false,
          blending,
        });
        material.fog = true;
        return new THREE.Sprite(material);
      }

      const craterDefs = [
        { x: -42, z: -4, r: 4.6 }, { x: -28, z: 12, r: 3.8 },
        { x: -17, z: -11, r: 5.2 }, { x: -4, z: 14, r: 3.4 },
        { x: 7, z: -13, r: 4.4 }, { x: 18, z: 8, r: 3.5 },
        { x: 29, z: -10, r: 4.0 }, { x: 43, z: 3, r: 3.2 },
        { x: -54, z: 16, r: 3.6 }, { x: 55, z: -14, r: 3.7 },
      ];
      const belt = (value, center, width) =>
        1 - smoothstep(width * 0.42, width, Math.abs(value - center));
      function terrainHeight(x, z) {
        let y =
          Math.sin(x * 0.055 + 0.7) * 0.36 +
          Math.cos(z * 0.075 - 0.4) * 0.30 +
          Math.sin((x + z) * 0.026) * 0.46 +
          Math.sin(x * 0.17) * Math.cos(z * 0.14) * 0.13;
        y *= 1 - belt(z, 5, 7.5) * 0.92;
        const coast = 1 - smoothstep(-30, -15, z);
        y = lerp(y, -1.08, coast * 0.9);
        if (z > 20) y += (z - 20) * 0.025;
        for (const crater of craterDefs) {
          const dx = x - crater.x;
          const dz = z - crater.z;
          const d2 = dx * dx + dz * dz;
          const r2 = crater.r * crater.r;
          if (d2 < r2) y -= 0.55 * (1 - d2 / r2);
        }
        return y;
      }
      const groundY = (x, z) => terrainHeight(x, z);

      // Terrain with deterministic vertex colors.
      {
        const geo = new THREE.PlaneGeometry(205, 128, 124, 78);
        geo.rotateX(-Math.PI / 2);
        const pos = geo.attributes.position;
        const colors = new Float32Array(pos.count * 3);
        const grass = new THREE.Color(0x4c5a30);
        const mud = new THREE.Color(0x5d4830);
        const dry = new THREE.Color(0x77673d);
        const sand = new THREE.Color(0xa98d5f);
        const under = new THREE.Color(0x53614f);
        const roadCol = new THREE.Color(0x51402e);
        const scar = new THREE.Color(0x332a21);
        const tmp = new THREE.Color();
        for (let i = 0; i < pos.count; i++) {
          const x = pos.getX(i);
          const z = pos.getZ(i);
          const y = terrainHeight(x, z);
          pos.setY(i, y);
          const patch = hash2(Math.floor(x / 3.2), Math.floor(z / 3.2));
          tmp.copy(grass).lerp(mud, patch * 0.72).lerp(dry, Math.max(0, y) * 0.18);
          tmp.lerp(roadCol, belt(z, 5, 6.5) * 0.82);
          tmp.lerp(sand, (1 - smoothstep(-26, -14, z)) * 0.88);
          if (y < -0.68) tmp.lerp(under, 0.62);
          for (const crater of craterDefs) {
            const dx = x - crater.x;
            const dz = z - crater.z;
            const d = Math.sqrt(dx * dx + dz * dz);
            if (d < crater.r * 1.15) tmp.lerp(scar, (1 - d / (crater.r * 1.15)) * 0.72);
          }
          colors[i * 3] = tmp.r;
          colors[i * 3 + 1] = tmp.g;
          colors[i * 3 + 2] = tmp.b;
        }
        geo.setAttribute("color", new THREE.BufferAttribute(colors, 3));
        geo.computeVertexNormals();
        const terrain = new THREE.Mesh(
          geo,
          new THREE.MeshStandardMaterial({
            vertexColors: true,
            roughness: 1,
            metalness: 0,
            flatShading: true,
          }),
        );
        terrain.receiveShadow = true;
        scene.add(terrain);
      }

      // Dirt road following the flattened terrain strip.
      {
        const geo = new THREE.PlaneGeometry(190, 7.4, 110, 1);
        geo.rotateX(-Math.PI / 2);
        const pos = geo.attributes.position;
        for (let i = 0; i < pos.count; i++) {
          const x = pos.getX(i);
          const z = pos.getZ(i) + 5;
          pos.setZ(i, z);
          pos.setY(i, terrainHeight(x, z) + 0.07);
        }
        geo.computeVertexNormals();
        const road = new THREE.Mesh(
          geo,
          new THREE.MeshStandardMaterial({
            color: 0x4d3d2a,
            roughness: 1,
            polygonOffset: true,
            polygonOffsetFactor: -1,
            polygonOffsetUnits: -1,
          }),
        );
        road.receiveShadow = true;
        scene.add(road);
      }

      // Animated ocean.
      let oceanGeometry;
      let oceanBase;
      {
        oceanGeometry = new THREE.PlaneGeometry(205, 58, 72, 18);
        oceanGeometry.rotateX(-Math.PI / 2);
        oceanBase = oceanGeometry.attributes.position.array.slice();
        const ocean = new THREE.Mesh(
          oceanGeometry,
          new THREE.MeshStandardMaterial({
            color: new THREE.Color(0x143751),
            roughness: 0.42,
            metalness: 0.02,
            envMapIntensity: 0.18,
          }),
        );
        ocean.position.set(0, -0.62, -49);
        ocean.receiveShadow = true;
        scene.add(ocean);
        for (let i = 0; i < 3; i++) {
          const foamGeo = new THREE.PlaneGeometry(200, 0.38, 1, 1);
          foamGeo.rotateX(-Math.PI / 2);
          const foam = new THREE.Mesh(
            foamGeo,
            new THREE.MeshBasicMaterial({
              color: 0xdfe9ec,
              transparent: true,
              opacity: 0.17 - i * 0.04,
              depthWrite: false,
            }),
          );
          foam.position.set(0, -0.5 + i * 0.015, -20.5 - i * 2.2);
          scene.add(foam);
        }
      }

      // Crater scorch discs.
      {
        const discGeo = new THREE.CircleGeometry(1, 28);
        discGeo.rotateX(-Math.PI / 2);
        const discMat = new THREE.MeshBasicMaterial({
          color: 0x211c16,
          transparent: true,
          opacity: 0.58,
          depthWrite: false,
          polygonOffset: true,
          polygonOffsetFactor: -2,
        });
        craterDefs.forEach((crater) => {
          const disc = new THREE.Mesh(discGeo, discMat);
          disc.scale.set(crater.r, 1, crater.r);
          disc.position.set(crater.x, terrainHeight(crater.x, crater.z) + 0.18, crater.z);
          scene.add(disc);
        });
      }

      const dummy = new THREE.Object3D();
      // Instanced grass and rocks keep drawing cost bounded.
      {
        const grass = new THREE.InstancedMesh(
          new THREE.ConeGeometry(0.16, 0.78, 5),
          new THREE.MeshStandardMaterial({ color: 0x66713a, roughness: 1 }),
          260,
        );
        for (let i = 0; i < 260; i++) {
          let x = -96 + hash(i + 1001) * 192;
          let z = -28 + hash(i + 1031) * 62;
          if (Math.abs(z - 5) < 5) z += z < 5 ? -7 : 7;
          if (z < -16) z = -16 + hash(i + 1061) * 5;
          const s = 0.65 + hash(i + 1091) * 1.15;
          dummy.position.set(x, terrainHeight(x, z) + 0.32 * s, z);
          dummy.rotation.set((hash(i + 1121) - 0.5) * 0.35, hash(i + 1151) * Math.PI, (hash(i + 1181) - 0.5) * 0.35);
          dummy.scale.set(s, s, s);
          dummy.updateMatrix();
          grass.setMatrixAt(i, dummy.matrix);
        }
        grass.instanceMatrix.needsUpdate = true;
        grass.receiveShadow = true;
        scene.add(grass);

        const rocks = new THREE.InstancedMesh(
          new THREE.DodecahedronGeometry(0.45, 0),
          new THREE.MeshStandardMaterial({ color: 0x6b675d, roughness: 1 }),
          120,
        );
        for (let i = 0; i < 120; i++) {
          const x = -94 + hash(i + 2001) * 188;
          let z = -22 + hash(i + 2031) * 54;
          if (Math.abs(z - 5) < 4.4) z += z < 5 ? -6 : 6;
          const s = 0.35 + hash(i + 2061) * 1.25;
          dummy.position.set(x, terrainHeight(x, z) + 0.16 * s, z);
          dummy.rotation.set(hash(i + 2091) * 3, hash(i + 2121) * 3, hash(i + 2151) * 3);
          dummy.scale.set(s * (0.8 + hash(i + 2181) * 0.7), s * 0.62, s);
          dummy.updateMatrix();
          rocks.setMatrixAt(i, dummy.matrix);
        }
        rocks.instanceMatrix.needsUpdate = true;
        rocks.castShadow = true;
        rocks.receiveShadow = true;
        scene.add(rocks);
      }

      function makeSandbagLine(x, z, ry, length) {
        const group = new THREE.Group();
        group.position.set(x, terrainHeight(x, z), z);
        group.rotation.y = ry;
        const cols = Math.max(3, Math.round(length / 0.72));
        const bags = new THREE.InstancedMesh(
          new THREE.SphereGeometry(0.5, 10, 7),
          MAT.sandbag,
          cols * 3,
        );
        let index = 0;
        for (let row = 0; row < 3; row++) {
          for (let col = 0; col < cols; col++) {
            dummy.position.set(
              -length / 2 + col * 0.72 + (row % 2) * 0.3,
              0.24 + row * 0.32,
              (hash(index + 3001) - 0.5) * 0.08,
            );
            dummy.rotation.set(0, hash(index + 3031) * 0.35, 0);
            dummy.scale.set(0.88, 0.36, 0.52);
            dummy.updateMatrix();
            bags.setMatrixAt(index++, dummy.matrix);
          }
        }
        bags.instanceMatrix.needsUpdate = true;
        bags.castShadow = true;
        bags.receiveShadow = true;
        group.add(bags);
        scene.add(group);
        return group;
      }
      makeSandbagLine(-16, 10.5, 0.08, 13);
      makeSandbagLine(15, -15.5, -0.05, 15);
      makeSandbagLine(35, -14.2, 0.04, 12);
      makeSandbagLine(-36, -7, 0.22, 10);

      function makeBarbedWire(x, z, ry, length) {
        const group = new THREE.Group();
        group.position.set(x, terrainHeight(x, z), z);
        group.rotation.y = ry;
        const ringGeo = new THREE.TorusGeometry(0.55, 0.025, 6, 18);
        const count = Math.max(4, Math.floor(length / 1.05));
