# SIDD AI VIDEO STUDIO — Local Environment Configuration Example
# Copy to .env to customize local paths and runtime limits.

# Host & port bindings (0.0.0.0 enables local network / sandbox preview)
SIDD_HOST=0.0.0.0
SIDD_PORT=8000

# User-configurable local storage directories (all data stays local)
SIDD_WORKSPACE_DIR=./workspace_data
SIDD_MODELS_DIR=./models_data
SIDD_DATABASE_PATH=./workspace_data/sidd_studio.db
SIDD_LOG_DIR=./logs

# Privacy & Network Policy
# True = strictly local video generation; model downloads require explicit user confirmation
SIDD_LOCAL_ONLY_DEFAULT=true
SIDD_ALLOW_MODEL_DOWNLOADS=false

# Optional Local LLM Endpoint (e.g., Ollama or llama.cpp server running locally on 127.0.0.1)
# Leave empty to use the built-in deterministic multilingual script analyzer
SIDD_LOCAL_LLM_URL=
SIDD_LOCAL_LLM_MODEL=

# Security limits
SIDD_MAX_UPLOAD_MB=50
SIDD_MAX_CONCURRENT_JOBS=1
