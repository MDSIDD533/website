# Public URL of the deployed FastAPI backend, without a trailing slash.
# Example after Koyeb/Zeabur/Back4App gives you a domain:
# VITE_API_BASE_URL=https://sidd-api.example.com
VITE_API_BASE_URL=https://YOUR-BACKEND-DOMAIN

# Optional. Leave empty to derive wss://<backend>/ws/jobs from the URL above.
# VITE_WS_URL=wss://YOUR-BACKEND-DOMAIN/ws/jobs
